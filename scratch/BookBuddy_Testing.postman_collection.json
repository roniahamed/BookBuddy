            "header": [
              { "key": "Authorization", "value": "Bearer {{borrower_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/conversations?filter_type=archive",
              "host": ["{{base_url}}"],
              "path": ["conversations"],
              "query": [{ "key": "filter_type", "value": "archive" }]
