            "body": {
              "mode": "raw",
              "raw": "{\n  \"body\": \"Sure! The book is available. You can pick it up Saturday morning at 10am. Does that work for you?\"\n}"
            },
            "url": { "raw": "{{base_url}}/conversations/{{conversation_id}}/messages", "host": ["{{base_url}}"], "path": ["conversations", "{{conversation_id}}", "messages"] },
            "description": "Owner sends a reply. This also triggers a push notification to the borrower (if FCM configured)."
          }
